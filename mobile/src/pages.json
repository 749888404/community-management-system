{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^u-(.*)": "uview-plus/components/u-$1/u-$1.vue",
      "^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/login/login",
      "style": {
        "navigationBarTitleText": "登录",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "首页"
      }
    },
    {
      "path": "pages/community/community",
      "style": {
        "navigationBarTitleText": "小区管理"
      }
    },
    {
      "path": "pages/person/person",
      "style": {
        "navigationBarTitleText": "居民管理"
      }
    },
    {
      "path": "pages/disabled/disabled",
      "style": {
        "navigationBarTitleText": "残疾人管理"
      }
    },
    {
      "path": "pages/file/file",
      "style": {
        "navigationBarTitleText": "文件管理"
      }
    },
    {
      "path": "pages/user/user",
      "style": {
        "navigationBarTitleText": "用户管理"
      }
    }
  ],
  "tabBar": {
    "color": "#909399",
    "selectedColor": "#2979ff",
    "backgroundColor": "#ffffff",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页"
      },
      {
        "pagePath": "pages/community/community",
        "text": "小区"
      },
      {
        "pagePath": "pages/person/person",
        "text": "居民"
      },
      {
        "pagePath": "pages/disabled/disabled",
        "text": "残疾人"
      },
      {
        "pagePath": "pages/file/file",
        "text": "文件"
      }
    ]
  },
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "社区管理系统",
    "navigationBarBackgroundColor": "#ffffff",
    "backgroundColor": "#f5f6f8"
  }
}
